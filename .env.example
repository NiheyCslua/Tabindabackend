# Copy this file to .env for local development and fill in real values.
# .env is gitignored — never commit real credentials.
# In production (Render), these are set in the dashboard's Environment tab instead.

DATABASE_URL="postgresql://user:password@localhost:5432/your_db_name"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS="http://localhost:3000"

# Port the server listens on (some hosts inject this automatically)
PORT=5000
